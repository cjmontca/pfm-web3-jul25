# Test Environment Configuration
NODE_ENV=test
PORT=5001

# Test Database Configuration  
MONGODB_URI=mongodb://localhost:27017/wine-traceability-test
REDIS_URL=redis://localhost:6379/1

# Mock Blockchain Configuration
USE_MOCK_BLOCKCHAIN=true
FABRIC_NETWORK_PATH=../fabric-network

# Test Security Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRE=1h
BCRYPT_ROUNDS=10

# Test Organization Configuration
VINEYARD_ORG_MSP=VineyardOrgMSP
WINERY_ORG_MSP=WineryOrgMSP
DISTRIBUTOR_ORG_MSP=DistributorOrgMSP
CONSUMER_ORG_MSP=ConsumerOrgMSP

# Test Logging
LOG_LEVEL=error