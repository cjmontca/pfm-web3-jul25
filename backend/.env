# Environment Configuration
NODE_ENV=production
PORT=5000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Hyperledger Fabric Configuration
FABRIC_NETWORK_PATH=../fabric-network
CHANNEL_NAME=wine-traceability-channel
USE_MOCK_BLOCKCHAIN=false

# Organization Configuration
VINEYARD_ORG_MSP=VineyardOrgMSP
WINERY_ORG_MSP=WineryOrgMSP
DISTRIBUTOR_ORG_MSP=DistributorOrgMSP
CONSUMER_ORG_MSP=ConsumerOrgMSP

# Chaincode Configuration
WINE_CHAINCODE_NAME=wine-traceability
CERT_CHAINCODE_NAME=quality-certification
TRANSFER_CHAINCODE_NAME=supply-chain-transfer

# Security Configuration
JWT_SECRET=wine-traceability-production-jwt-secret-2024-hyperledger-fabric
JWT_EXPIRE=24h
BCRYPT_ROUNDS=12

# Super-Admin MetaMask Configuration
SUPER_ADMIN_WALLETS=0x25E93088a2ab13E6C4732122C996e56Ef85fcF79

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/wine-traceability
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# API Configuration
API_VERSION=v1
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# QR Code Configuration
QR_CODE_SIZE=200
QR_CODE_ERROR_CORRECTION=M

# File Upload Configuration
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf