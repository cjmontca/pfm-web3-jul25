# Blockchain Configuration
NODE_ENV=production
PORT=3001

# Hyperledger Fabric Configuration
CHANNEL_NAME=wine-traceability
CHAINCODE_NAME=wine-traceability
FABRIC_NETWORK_PATH=../fabric-network

# Database Configuration  
MONGODB_URI=mongodb://localhost:27017/wine-traceability
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=wine-traceability-blockchain-secret-2025
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info

# Blockchain Network Settings
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_MODE=blockchain-only
FABRIC_TLS_ENABLED=false